# Editor configuration for the Chakaso repository.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
# Markdown uses trailing double-spaces for hard line breaks, and lists read
# better unwrapped at two spaces of indent for nesting clarity.
trim_trailing_whitespace = false

[*.{toml,yaml,yml,json}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[Makefile]
indent_style = tab
